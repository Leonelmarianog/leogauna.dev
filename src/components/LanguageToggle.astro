---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeDictionary, type Locale } from '../i18n/ui';
import { pathWithoutLocale, useTranslations } from '../i18n/utils';

interface Props {
  /** The Locale of the current page. The link leads to the other one. */
  locale: Locale;
}

const { locale } = Astro.props;
const targetLocale = localeDictionary[locale];
const t = useTranslations(targetLocale);
const href = getRelativeLocaleUrl(targetLocale, pathWithoutLocale(Astro.url.pathname, locale));
---

<a
  class="corner-control language-toggle"
  href={href}
  lang={targetLocale}
  hreflang={targetLocale}
  aria-label={t('locale.viewIn')}>{t('locale.code')}</a
>

<script>
  import { localePreferenceKey } from '../i18n/preference';

  // Save the chosen Locale as the Locale preference, then let the link navigate.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.language-toggle')) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(localePreferenceKey, link.hreflang);
      } catch {
        // Storage is blocked: the link still switches Locale, but the choice is not remembered.
      }
    });
  }
</script>
