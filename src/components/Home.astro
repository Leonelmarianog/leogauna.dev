---
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.title')} description={t('meta.description')}>
  <header class="corner-controls">
    <LanguageToggle locale={locale} />
    <ThemeToggle locale={locale} />
  </header>
  <main>
    <div class="content">
      <h1>
        <span class="greeting">{t('home.greeting')}</span>
        <span class="name">{t('home.name')}</span>
      </h1>
      <p class="summary">{t('home.summary')}</p>
      <ul class="links">
        <li><a class="button button-filled" href={site.cvUrl} download={site.cvFileName}>{t('home.cv')}</a></li>
        <li>
          <a class="button" href={site.linkedinUrl} target="_blank" rel="noopener noreferrer"
            >{t('home.linkedin')}</a
          >
        </li>
        <li>
          <a class="button" href={site.githubUrl} target="_blank" rel="noopener noreferrer"
            >{t('home.github')}</a
          >
        </li>
        <li><a class="button" href={`mailto:${site.email}`}>{t('home.email')}</a></li>
      </ul>
    </div>
  </main>
</Layout>

<style>
  /* Absolute, not fixed: when the page must scroll, the controls scroll away instead of covering content. */
  .corner-controls {
    position: absolute;
    inset-block-start: var(--corner-inset-top);
    inset-inline-end: var(--corner-inset-right);
    display: flex;
    gap: 0.75rem;
  }

  /*
   * Three rows: the content sits in the middle and the free space splits evenly above and below it.
   * The rows keep a minimum, so the content moves down instead of under the corner controls,
   * and the page scrolls once the content no longer fits.
   */
  main {
    --space-above: 1.5rem;
    --space-below: 1.5rem;
    display: grid;
    grid-template-rows: minmax(var(--space-above), 1fr) auto minmax(var(--space-below), 1fr);
    justify-items: center;
    min-height: 100dvh;
    padding-inline: max(1.5rem, env(safe-area-inset-left)) max(1.5rem, env(safe-area-inset-right));
  }

  /* As wide as the heading or the button row, whichever is wider. */
  .content {
    grid-row: 2;
    width: fit-content;
    max-width: min(47.5rem, 100%);
  }

  /* The name scales over a wider range than the body text, so it has its own clamp(). */
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 0.25rem + min(9.5vw, 9.5vh), 6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .greeting,
  .name {
    display: block;
  }

  .greeting {
    font-size: 0.36em;
    letter-spacing: -0.02em;
    margin-block-end: 0.15em;
  }

  /* contain: wrap the summary to the width of the heading and buttons, not its own text. */
  .summary {
    contain: inline-size;
    margin: 1.5em 0 0;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin: 1.75em 0 0;
    padding: 0;
    list-style: none;
  }

  .button {
    display: block;
    padding: 0.75em 1.5em;
    border: 1.5px solid var(--color-text);
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .button-filled {
    background-color: var(--color-text);
    color: var(--color-filled-text);
  }

  .button:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  /* Narrow screens: the button row no longer fits, so the buttons stack in one full-width column. */
  @media (max-width: 38em) {
    .content {
      width: 100%;
    }

    .links {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /*
   * Phone width: the name reaches the corner, so it starts below the corner controls.
   * The short greeting may sit beside them: it is at least 0.8rem tall, so starting the content
   * 0.5rem above the controls' bottom edge keeps the name clear.
   */
  @media (max-width: 30em) {
    main {
      --space-above: calc(var(--corner-inset-top) + var(--corner-control-size) - 0.5rem);
      --space-below: 1rem;
    }
  }

  /* Phones and short screens: tighter spacing so the content fits without scrolling. */
  @media (max-width: 30em), (max-width: 38em) and (max-height: 30em) {
    .summary,
    .links {
      margin-block-start: 1em;
    }

    .button {
      padding-block: 0.5em;
    }
  }

  /* Short screens, such as a phone in landscape: the buttons form a 2×2 grid and the spacing tightens. */
  @media (min-width: 30em) and (max-width: 38em) and (max-height: 30em) {
    main {
      --space-above: 1rem;
      --space-below: 1rem;
    }

    .links {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
