---
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t('meta.title')} description={t('meta.description')}>
  <main>
    <div class="content">
      <h1>
        <span class="greeting">{t('home.greeting')}</span>
        <span class="name">{t('home.name')}</span>
      </h1>
      <p class="summary">{t('home.summary')}</p>
      <ul class="links">
        <li><a class="button button-filled" href={site.cvUrl} download={site.cvFileName}>{t('home.cv')}</a></li>
        <li>
          <a class="button" href={site.linkedinUrl} target="_blank" rel="noopener noreferrer"
            >{t('home.linkedin')}</a
          >
        </li>
        <li>
          <a class="button" href={site.githubUrl} target="_blank" rel="noopener noreferrer"
            >{t('home.github')}</a
          >
        </li>
        <li><a class="button" href={`mailto:${site.email}`}>{t('home.email')}</a></li>
      </ul>
    </div>
  </main>
</Layout>

<style>
  main {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: 1.5rem;
  }

  .content {
    width: 100%;
    max-width: 47.5rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 1rem + min(8vw, 8vh), 6.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .greeting,
  .name {
    display: block;
  }

  .greeting {
    /* About 0.36 of the name size. */
    font-size: clamp(1rem, 0.36rem + min(2.88vw, 2.88vh), 2.375rem);
    letter-spacing: -0.02em;
    margin-block-end: 0.4em;
  }

  .summary {
    margin: clamp(1.25rem, 0.5rem + min(2vw, 2vh), 2rem) 0 0;
    max-width: 60ch;
    font-size: clamp(1rem, 0.75rem + min(0.8vw, 0.8vh), 1.25rem);
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: clamp(1.5rem, 0.75rem + min(2.5vw, 2.5vh), 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .button {
    display: inline-block;
    padding: 0.75em 1.25em;
    border: 1.5px solid var(--color-text);
    border-radius: 999px;
    color: var(--color-text);
    font-size: clamp(0.9375rem, 0.75rem + min(0.5vw, 0.5vh), 1.0625rem);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .button-filled {
    background-color: var(--color-text);
    color: var(--color-filled-text);
  }

  .button:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }
</style>
