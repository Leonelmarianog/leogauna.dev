---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { defaultLocale, locales, type Locale } from '../i18n/ui';
import { pathWithoutLocale } from '../i18n/utils';
import LocalePreferenceRedirect from '../components/LocalePreferenceRedirect.astro';
import ThemePreference from '../components/ThemePreference.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const path = pathWithoutLocale(Astro.url.pathname, locale);
/** Only `/` follows the Locale preference. Every other page keeps its Locale through its URL. */
const isDefaultHome = locale === defaultLocale && path === '';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {isDefaultHome && <LocalePreferenceRedirect />}
    <ThemePreference />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      locales.map((alternate) => (
        <link rel="alternate" hreflang={alternate} href={getAbsoluteLocaleUrl(alternate, path)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <slot />
  </body>
</html>
